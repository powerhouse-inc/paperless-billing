# Paperless -> Powerhouse billing demo.
#
#   cp .env.example .env        # then fill in PAPERLESS_AI_API_KEY
#   ./start.sh
#
# Every value below except the API key has a working default in
# docker-compose.yml. Uncomment a line only to override it.
# Restart the stack after editing -- these are read once, at startup.

# ---- Required ----------------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave the base URL empty to use the Anthropic
# API instead (then this is an Anthropic key).
PAPERLESS_AI_BASE_URL=https://openrouter.ai/api/v1
PAPERLESS_AI_MODEL=openai/gpt-oss-120b
PAPERLESS_AI_API_KEY=

# ---- Host ports --------------------------------------------------------------
# Change to run alongside another Paperless or reactor.
# PAPERLESS_HOST_PORT=8000
# CONNECT_HOST_PORT=3000
# SWITCHBOARD_HOST_PORT=4001     # Connect's drive URL follows this automatically

# ---- Versions (optional) -----------------------------------------------------
# Mirrors the defaults in docker-compose.yml, which apply if you leave these
# alone. Uncomment to install different versions -- the two packages and the
# image are one compatibility set, so move them together. Tags are v-prefixed.
# PAPERLESS_SYNC_VERSION=0.2.8
# BILLING_VERSION=0.0.4
# PH_IMAGE_TAG=v6.2.2-dev.68

# ---- Misc --------------------------------------------------------------------
# Dev-only shared secret Paperless presents on webhook calls.
# PAPERLESS_WEBHOOK_SECRET=local-dev-webhook-secret-not-for-production
