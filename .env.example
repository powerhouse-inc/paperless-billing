# Paperless -> Powerhouse billing demo.
#
#   cp .env.example .env        # then fill in PAPERLESS_AI_API_KEY
#   ./start.sh
#
# Compose reads this file automatically. Restart the stack after editing it --
# the reactor reads these once, at startup.

# ---- The ONLY value you must fill in -----------------------------------------
# Change to any other AI model with API key


PAPERLESS_AI_BASE_URL=https://openrouter.ai/api/v1
PAPERLESS_AI_MODEL=openai/gpt-oss-120b
PAPERLESS_AI_API_KEY=


# Host ports. Change these to run alongside another Paperless or reactor.
# PAPERLESS_HOST_PORT=8000
# CONNECT_HOST_PORT=3000
# SWITCHBOARD_HOST_PORT=4001   (matches paperless-package; Connect follows it)
